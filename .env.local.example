# Copie este arquivo para .env.local e preencha os valores.
# .env.local NUNCA vai pro git (ver .gitignore). Só este .example é versionado.

# ───────────────────────────────────────────────────────────────────────────
# CHAVE DA IA — server-side APENAS (lida só na API Route). Jamais no bundle.
# Pegue em: https://console.anthropic.com  →  Settings  →  API Keys
# Billing é pré-pago (pay-as-you-go), SEPARADO da sua assinatura Claude.ai.
# ───────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado na curadoria. Troque aqui pra mudar custo x qualidade (1 linha):
#   claude-haiku-4-5   → mais barato  (~US$0,05/análise)  ← default p/ testar
#   claude-sonnet-4-6  → equilíbrio   (~US$0,15/análise)
#   claude-opus-4-8    → melhor       (~US$0,25-0,70/análise)
ANTHROPIC_MODEL=claude-haiku-4-5

# ───────────────────────────────────────────────────────────────────────────
# PAGAMENTO — PÚBLICO (vai pro client de propósito; é só um link de checkout).
# Cole aqui o link do seu produto na Kiwify (ou outra plataforma).
# Na Kiwify, configure a URL de redirecionamento pós-compra para:
#   https://SEU-DOMINIO/success     (em dev: o link do ngrok + /success)
# ───────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYMENT_LINK=https://pay.kiwify.com.br/SEU-LINK-AQUI

# ───────────────────────────────────────────────────────────────────────────
# UPSTASH REDIS (KV) — rate limit + prova de pagamento. Server-side.
# Na Vercel são injetadas automático ao conectar o banco Upstash ao projeto.
# ───────────────────────────────────────────────────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ───────────────────────────────────────────────────────────────────────────
# PAYWALL real (webhook Kiwify + cookie assinado). Server-side.
#   DUMPAI_COOKIE_SECRET — segredo aleatório p/ assinar o cookie de acesso.
#       Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   KIWIFY_WEBHOOK_TOKEN — token do webhook configurado na Kiwify.
#   PAYWALL_ATIVO=true   — LIGA a exigência de pagamento no /api/curate.
#       Mantenha desligado até testar o webhook ponta a ponta.
# ───────────────────────────────────────────────────────────────────────────
DUMPAI_COOKIE_SECRET=
KIWIFY_WEBHOOK_TOKEN=
# PAYWALL_ATIVO=true

# ───────────────────────────────────────────────────────────────────────────
# Limites do MVP (opcionais — já têm default no código).
# ───────────────────────────────────────────────────────────────────────────
# MAX_FOTOS=30
# MAX_PAYLOAD_MB=25
